{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Backend API Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "restart": true,
      "runtimeArgs": ["--watch"],
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/src/**/*.js"]
    },
    {
      "name": "Debug: Run Migration",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/migrate.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug: Run Seed Script",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug: Attach to Running Node Process",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
