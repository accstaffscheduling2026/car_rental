# Environment variables — never commit secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
frontend/dist/
coverage/

# Database — contains real customer data, never commit
data/
*.sqlite

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sensitive files — keys, passwords, credentials
car_rental/
stripe keys.txt
*keys*.txt
*secret*.txt
*password*.txt

# Uploaded legal documents — keep directory structure, not the files
uploads/legal/*.pdf

# OS files
.DS_Store
Thumbs.db
